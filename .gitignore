# --- Secrets and credentials: never commit ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
*.secret
secrets/
credentials*.json
.netrc
.npmrc
.pypirc

# --- Runtime data: uploads, index, investigation history, generated evals ---
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
evals/*.json
vectorstore/
*.faiss
*.pkl
logs/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# --- Node / Angular (frontend/.gitignore has the full list) ---
node_modules/
.angular/
npm-debug.log*

# --- Editors and OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- Local screenshots and scratch files ---
acree/
Screenshot*.png
*.tmp
*.bak
