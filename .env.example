# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Real environment variables take priority over this file.

# LLM provider: ollama (default, local and free) | anthropic | openai
LOGINTEL_PROVIDER=ollama
LOGINTEL_OLLAMA_BASE_URL=http://localhost:11434
LOGINTEL_LLM_MODEL=qwen3:4b
LOGINTEL_EMBED_MODEL=nomic-embed-text

# Only needed for an optional paid provider. Never commit a real key.
# LOGINTEL_API_KEY=

# Storage (relative to the working directory)
LOGINTEL_INDEX_DIR=data/index
LOGINTEL_UPLOAD_DIR=data/uploads
LOGINTEL_MAX_UPLOAD_MB=20

# Retrieval and chunking
LOGINTEL_TOP_K=5
LOGINTEL_WINDOW_SECONDS=30
